# Reproduces a deadlock in capturing a job's result as a value (`$var := $(...)`, a
# named argument like `join`'s, etc.): src/lang/value/value_definition.rs's
# ValueDefinition::JobDefinition::eval starts the job on a worker thread, then calls
# `threads().join_one(id)` -- which blocks until that thread *fully exits* -- before
# ever reading the value the thread produced. That's fine for a job that sends one small
# value, but a stream's own row channel (`streams()` in src/lang/pipe.rs) only buffers
# 128 rows. Past that, the producer thread blocks on `output.send()` waiting for a
# reader, and the only candidate reader is stuck waiting for the producer to exit --
# deadlock. src/lang/command/closure.rs's per-statement eval has the identical shape, so
# a closure body producing more than 128 rows is affected the same way.
#
# This never showed up before because everything in the existing test suite streams far
# fewer than 128 rows at a time. It was found via `language_reference.md`'s own `join`
# example, which joined `files` (usually well under 128 entries) against `users:list`
# (which enumerates every system account -- 300+ on a real machine).
#
# Run the same shape twice, with different (but equally oversized) data each time, so a
# fix that only happens to work on the first occurrence doesn't slip through.
#
# This test currently hangs forever if run directly -- see tests/system.rs's
# test_join_large_stream_does_not_deadlock, which runs it under an explicit timeout
# instead, since a plain golden-file run has no way to fail a script that never
# terminates.

$left1 := $(seq 1 1001 | rename value=id)
$right1 := $(seq 1 1001 | rename value=id)
$joined1 := $(join id=$left1 id=$right1 | count)
assert ($joined1 == 1000) "joining two 1000-row streams should produce 1000 matching rows"

$left2 := $(seq 500 1500 | rename value=id)
$right2 := $(seq 500 1500 | rename value=id)
$joined2 := $(join id=$left2 id=$right2 | count)
assert ($joined2 == 1000) "a second, independent 1000-row join should also complete and produce the correct row count"

echo "ok"
