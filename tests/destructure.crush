# [$a $b ...] := value / [$a $b ...] = value destructure a list, struct, or dict into
# several variables at once. Struct and dict are both backed by an order-preserving map,
# so "positional" destructuring of either one means "in insertion order". Supported in
# both Command mode (plain statements, tested first below) and Expression mode (inside
# `(...)`, tested in the second half of this file) -- both for := (declaration) and =
# (reassignment).

## Command mode

# List, via :=
[$a $b] := $(list:of 1 2)
assert ($a == 1) "list destructuring should assign the first element to the first name"
assert ($b == 2) "list destructuring should assign the second element to the second name"

# A single target is a degenerate but valid case, not just a two-or-more feature.
[$only] := $(list:of 42)
assert ($only == 42) "single-target destructuring should work too"

# Struct, via :=
$point := $(struct:of x=10 y=20)
[$px $py] := $point
assert ($px == 10) "struct destructuring should assign fields in declaration order"
assert ($py == 20) "struct destructuring should assign fields in declaration order"

# Dict, via := -- insertion order, not key order
$d := $($(dict $string $integer):new)
$d["z"] = 1
$d["a"] = 2
[$first $second] := $d
assert ($first == 1) "dict destructuring should use insertion order, not key order"
assert ($second == 2) "dict destructuring should use insertion order, not key order"

# Reassignment via =, on already-declared variables
[$a $b] = $(list:of 100 200)
assert ($a == 100) "= destructuring should reassign existing variables"
assert ($b == 200) "= destructuring should reassign existing variables"

# Three-way destructuring, to make sure this isn't hardcoded to exactly two names
[$one $two $three] := $(list:of "x" "y" "z")
assert ($one == "x") "three-way destructuring should work, not just two"
assert ($two == "y") "three-way destructuring should work, not just two"
assert ($three == "z") "three-way destructuring should work, not just two"

# Wrong element count: too few
$errored := $false
try {
    [$m1 $m2 $m3] := $(list:of 1 2)
} catch {|$e|
    $errored = $true
}
assert $errored "destructuring with more names than elements should error"

# Wrong element count: too many
$errored2 := $false
try {
    [$m1 $m2] := $(list:of 1 2 3)
} catch {|$e|
    $errored2 = $true
}
assert $errored2 "destructuring with more elements than names should error"

# Only list/struct/dict can be destructured
$errored3 := $false
try {
    [$m1 $m2] := 5
} catch {|$e|
    $errored3 = $true
}
assert $errored3 "destructuring a value that isn't a list, struct, or dict should error"

# = requires every name to already exist, exactly like plain set does
$errored4 := $false
try {
    [$never_declared_1 $never_declared_2] = $(list:of 1 2)
} catch {|$e|
    $errored4 = $true
}
assert $errored4 "= destructuring on undeclared variables should error, like set does"

# := requires every name to not already exist in the local scope, exactly like plain let
# does. Both the initial declaration and the redeclaration happen inside the same
# try/catch body (rather than one outside, one inside) so they share one local scope --
# try/catch introduces its own child scope, and declaring a variable in an *enclosing*
# scope wouldn't count as a local redeclaration.
$errored5 := $false
try {
    $already := 1
    [$already $new_one] := $(list:of 1 2)
} catch {|$e|
    $errored5 = $true
}
assert $errored5 ":= destructuring should error when a name already exists in the local scope, like let does"

## Expression mode

# In expression mode, [$a, $b] reuses the same bracket syntax as an ordinary list
# literal -- but unlike Command mode, expression mode's own list-literal syntax is
# comma/newline-separated (`([1, 2, 3])` works, `([1 2 3])` does not), so destructuring
# targets follow that same convention here instead of Command mode's bare whitespace.

([$ea, $eb] := $(list:of 1 2))
assert ($ea == 1) "expression mode: list destructuring via :=, first name"
assert ($eb == 2) "expression mode: list destructuring via :=, second name"

$epoint := $(struct:of x=10 y=20)
([$epx, $epy] := $epoint)
assert ($epx == 10) "expression mode: struct destructuring via := should use declaration order"
assert ($epy == 20) "expression mode: struct destructuring via := should use declaration order"

$ed := $($(dict $string $integer):new)
$ed["z"] = 1
$ed["a"] = 2
([$efirst, $esecond] := $ed)
assert ($efirst == 1) "expression mode: dict destructuring via := should use insertion order, not key order"
assert ($esecond == 2) "expression mode: dict destructuring via := should use insertion order, not key order"

([$ea, $eb] = $(list:of 100 200))
assert ($ea == 100) "expression mode: = destructuring should reassign existing variables"
assert ($eb == 200) "expression mode: = destructuring should reassign existing variables"

# A plain list literal must still work exactly as before -- destructuring assignment
# and list literals now share one AST node internally, so this is the regression check
# that the sharing didn't change ordinary list-literal behavior.
$plain_list := ([1, 2, 3])
assert ($($plain_list:len) == 3) "expression mode: an ordinary list literal should be unaffected by sharing an AST node with destructuring"
$plain_list_sum := $($plain_list | sum)
assert ($plain_list_sum == 6) "expression mode: an ordinary list literal's values should be unaffected"

$eerrored := $false
try {
    ([$em1, $em2, $em3] := $(list:of 1 2))
} catch {|$e|
    $eerrored = $true
}
assert $eerrored "expression mode: destructuring with more names than elements should error"

$eerrored2 := $false
try {
    ([$em1, $em2] := $(list:of 1 2 3))
} catch {|$e|
    $eerrored2 = $true
}
assert $eerrored2 "expression mode: destructuring with more elements than names should error"

$eerrored3 := $false
try {
    ([$em1, $em2] := 5)
} catch {|$e|
    $eerrored3 = $true
}
assert $eerrored3 "expression mode: destructuring a value that isn't a list, struct, or dict should error"

$eerrored4 := $false
try {
    ([$never_declared_e1, $never_declared_e2] = $(list:of 1 2))
} catch {|$e|
    $eerrored4 = $true
}
assert $eerrored4 "expression mode: = destructuring on undeclared variables should error, like set does"

$eerrored5 := $false
try {
    $ealready := 1
    ([$ealready, $enew_one] := $(list:of 1 2))
} catch {|$e|
    $eerrored5 = $true
}
assert $eerrored5 "expression mode: := destructuring should error when a name already exists in the local scope, like let does"
