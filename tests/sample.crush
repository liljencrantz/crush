# stream:sample reservoir-samples `rows` rows from the input, giving every row an
# equal chance of ending up in the output without materializing the whole stream.

# Sampling fewer rows than available returns exactly `rows` rows.
assert ($(seq 1 1001 | sample 20 | count) == 20) "sample should return exactly `rows` rows when input is larger"

# Every sampled row's value came from the original stream's range.
assert $(seq 1 1001 | sample 20 | all_match {($value >= 1)}) "sampled values should all be >= the input's lower bound"
assert $(seq 1 1001 | sample 20 | all_match {($value < 1001)}) "sampled values should all be < the input's upper bound"

# Sampling never invents duplicate rows out of thin air -- each sampled value is
# still unique, since the input stream's values were.
assert ($(seq 1 1001 | sample 20 | uniq value | count) == 20) "sample should not duplicate rows"

# Sampling more rows than available returns the whole input, since the reservoir can
# never grow past what it saw.
assert ($(seq 1 5 | sample 100 | count) == 4) "sample should return the whole input when rows exceeds its size"

# Sampling an empty stream returns an empty stream.
assert ($(seq 0 0 | sample 5 | count) == 0) "sample over an empty stream should return nothing"
