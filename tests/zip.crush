$age := $(lines:from ./example_data/age.csv|materialize)
$home := $(lines:from ./example_data/home.csv|materialize)

zip $(lines:from ./example_data/age.csv) $(lines:from ./example_data/home.csv) | echo
zip $age $home | head 1 | echo
zip $(lines:from ./example_data/age.csv) $home | head 1 | echo
zip $age $(lines:from ./example_data/home.csv) | head 1 | echo
