$count := 0
loop {
    $count = ($count + 1)
    break
    $count = 9999
}
assert ($count == 1) "break should stop the loop before the unreachable statement runs"

$a := $false
$two_count := 0
$continue_ran_unreachable := $false
loop {
    if $a $break
    $a = $true
    $two_count = ($two_count + 1)
    continue
    $continue_ran_unreachable = $true
}
assert ($two_count == 1) "the loop body should run exactly once before break"
assert (!$continue_ran_unreachable) "continue should skip the statement after it"
