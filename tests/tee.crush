# tee runs each branch as its own independent pipeline against a copy of the input,
# discarding the branch's own output -- a branch is only useful for its side effects
# -- while tee's own output is the original stream, untouched, so it composes directly
# into a larger pipeline.
rm ./.tee_test.json

# The passthrough is unaffected by having one or more branches attached.
$sum := $(seq 1 6 | tee {count} | fold {($acc + $value)} initial=0)
assert ($sum == 15) "tee's passthrough output should be the untouched original stream"

# Multiple branches all run, and one of them can have a real side effect (writing a
# file) without disturbing the others or the passthrough.
$sum2 := $(seq 1 6 | tee {json:to ./.tee_test.json} {count} | fold {($acc + $value)} initial=0)
assert ($sum2 == 15) "tee's passthrough should be unaffected by a branch that writes a file"

$restored := $(json:from ./.tee_test.json | fold {($acc + $value)} initial=0)
assert ($restored == 15) "the branch's own file should contain a full, correct copy of the stream"

# A failing branch is reported to crush:warn:list rather than aborting tee or the
# other branches.
$sum3 := $(seq 1 6 | tee {this_command_does_not_exist} | fold {($acc + $value)} initial=0)
assert ($sum3 == 15) "a failing branch should not affect tee's own passthrough output"
assert ($(crush:warn:list | count) > 0) "a failing branch should be reported via crush:warn:list"

# tee over an empty stream runs each branch with no rows and passes nothing through.
$empty_sum := $($(seq 0 0) | tee {count} | fold {($acc + $value)} initial=0)
assert ($empty_sum == 0) "tee over an empty stream should pass nothing through"

# tee requires at least one branch.
$errored := $false
try {
    seq 1 6 | tee | count
} catch {|$e|
    $errored = $true
}
assert $errored "tee with no branches at all should error"

rm ./.tee_test.json
