# avg/median/max/min have no sensible default for an empty stream and are expected to
# error; sum/prod do (0 and 1 respectively) and are expected to succeed with that value.

$avg_errored := $false
try { seq 0 0 | avg } catch { |$e| $avg_errored = $true }
assert $avg_errored "avg of an empty stream should error"

$median_errored := $false
try { seq 0 0 | median } catch { |$e| $median_errored = $true }
assert $median_errored "median of an empty stream should error"

$max_errored := $false
try { seq 0 0 | max } catch { |$e| $max_errored = $true }
assert $max_errored "max of an empty stream should error"

$min_errored := $false
try { seq 0 0 | min } catch { |$e| $min_errored = $true }
assert $min_errored "min of an empty stream should error"

assert (($(seq 0 0 | prod)) == 1) "prod of an empty stream should be 1"
assert (($(seq 0 0 | sum)) == 0) "sum of an empty stream should be 0"
