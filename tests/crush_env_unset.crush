# crush:env supports get/set/list of environment variables, but had no way to remove one.
crush:env["CRUSH_TEST_VAR"] = "hello"
$v1 := $(crush:env["CRUSH_TEST_VAR"])
assert ($v1 == "hello")

crush:env:unset "CRUSH_TEST_VAR"
$unset_errored := $false
try { crush:env["CRUSH_TEST_VAR"] } catch { |$e| $unset_errored = $true }
assert $unset_errored "getting an unset environment variable should error"
