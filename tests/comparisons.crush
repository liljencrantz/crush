# Integer comparisons
assert (!(1 > 2))
assert (1 < 2)
assert (!(1 >= 2))
assert (1 <= 2)
assert (1 != 2)
assert (!(1 == 2))

assert (!(2 > 2))
assert (!(2 < 2))
assert (2 >= 2)
assert (2 <= 2)
assert (!(2 != 2))
assert (2 == 2)

assert (2 > 1)
assert (!(2 < 1))
assert (2 >= 1)
assert (!(2 <= 1))
assert (2 != 1)
assert (!(2 == 1))

# Float comparisons
assert (!(1.0 > 2.0))
assert (1.0 < 2.0)
assert (!(1.0 >= 2.0))
assert (1.0 <= 2.0)
assert (1.0 != 2.0)
assert (!(1.0 == 2.0))

# Duration comparisons
assert (!($(duration:of seconds=1) > $(duration:of seconds=2)))
assert ($(duration:of seconds=1) < $(duration:of seconds=2))
assert (!($(duration:of seconds=1) >= $(duration:of seconds=2)))
assert ($(duration:of seconds=1) <= $(duration:of seconds=2))
assert ($(duration:of seconds=1) != $(duration:of seconds=2))
assert (!($(duration:of seconds=1) == $(duration:of seconds=2)))

# Time comparisons
$t1 := (time.now())
$t2 := (time.now() + duration.of(seconds=1))
assert (!($t1 > $t2))
assert ($t1 < $t2)
assert (!($t1 >= $t2))
assert ($t1 <= $t2)
assert ($t1 != $t2)
assert (!($t1 == $t2))

# String comparisons
assert (!("a" > "b"))
assert ("a" < "b")
assert (!("a" >= "b"))
assert ("a" <= "b")
assert ("a" != "b")
assert (!("a" == "b"))

# Float edge cases: NaN equality (never equal, even to itself)
$nan := (0.0 / 0.0)
assert (!($nan == $nan))
assert ($nan != $nan)
assert (!($nan == 5.0))
assert ($nan != 5.0)

# Float edge cases: signed zero (equal per IEEE 754, despite the differing sign bit)
assert (0.0 == (-0.0))
assert (!(0.0 != (-0.0)))
assert (!(0.0 > (-0.0)))
assert (!(0.0 < (-0.0)))
assert (0.0 >= (-0.0))
assert (0.0 <= (-0.0))

# Float edge cases: infinity
$inf := (1.0 / 0.0)
$ninf := (-1.0 / 0.0)
assert ($inf == $inf)
assert ($inf != $ninf)
assert ($inf > 999999999.0)
assert ($ninf < (-999999999.0))
assert ($inf > $ninf)
assert ($ninf < $inf)
assert ($inf >= $inf)
assert ($ninf <= $inf)

# Ordering comparisons (unlike == and !=) go through partial_cmp, and NaN is unordered
# with respect to everything, including itself -- comp.rs's cmp! macro treats a `None`
# result from partial_cmp as an error rather than silently returning false.
$nan_ordering_errored := $false
try {
    ($nan > 5)
} catch {
    |$error| $nan_ordering_errored = $true
}
assert $nan_ordering_errored "NaN ordering comparisons should error rather than return a boolean"
