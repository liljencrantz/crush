echo "Integer comparisons"

echo (1>2)
echo (1<2)
echo (1>=2)
echo (1<=2)
echo (1!=2)
echo (1==2)

echo (2>2)
echo (2<2)
echo (2>=2)
echo (2<=2)
echo (2!=2)
echo (2==2)

echo (2>1)
echo (2<1)
echo (2>=1)
echo (2<=1)
echo (2!=1)
echo (2==1)
echo "Float comparisons"

echo (1.0>2.0)
echo (1.0<2.0)
echo (1.0>=2.0)
echo (1.0<=2.0)
echo (1.0!=2.0)
echo (1.0==2.0)
echo "Duration comparisons"

echo ($(duration:of seconds=1) > $(duration:of seconds=2))
echo ($(duration:of seconds=1) < $(duration:of seconds=2))
echo ($(duration:of seconds=1) >= $(duration:of seconds=2))
echo ($(duration:of seconds=1) <= $(duration:of seconds=2))
echo ($(duration:of seconds=1) != $(duration:of seconds=2))
echo ($(duration:of seconds=1) == $(duration:of seconds=2))

echo "Time comparisons"

$t1 := (time.now())
$t2 := (time.now() + duration.of(seconds=1))

echo ($t1 > $t2)
echo ($t1 < $t2)
echo ($t1 >= $t2)
echo ($t1 <= $t2)
echo ($t1 != $t2)
echo ($t1 == $t2)

echo "String comparisons"

echo ("a" > "b")
echo ("a" < "b")
echo ("a" >= "b")
echo ("a" <= "b")
echo ("a" != "b")
echo ("a" == "b")
