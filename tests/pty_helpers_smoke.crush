# Smoke test for the pty builtin's `wait_quiet`/`run` primitives (see
# src/builtins/pty/session.rs's `PtySession::wait_quiet`).
#
# `run` is sugar for "submit this line, then wait until the screen stops changing" --
# it proves a command actually ran and the session is usable again afterward, without
# needing a specific string to match (unlike `wait_for`).
#
# A bare `wait_quiet` (no pattern) is also useful standalone: it replaces the blind
# `sleep $(duration:of milliseconds=300)` that every existing tests/pty_*.crush file
# uses after writing a command, with "wait until nothing new has arrived for a while"
# instead of "wait a fixed guess and hope it was long enough".
$crush_bin := $(crush:env["CRUSH_BIN"])
$t := $(pty:create $crush_bin)
$t:wait_for "# "

$t:run "echo hello"
$t:wait_for "hello"

$t:write "sleep $(duration:of seconds=100)\n"
$t:wait_quiet
$t:write $t:control:z
$t:wait_for "# "
$t:write "jobs\n"
$t:wait_for "Paused"

$t:close
echo "ok"
