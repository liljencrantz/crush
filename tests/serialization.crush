rm ./.test_file
# Pipe output of find into a file
files ./example_data/tree|select file type | sort file | pup:to ./.test_file
# And read it back out again
$(pup:from ./.test_file)[0] | member file | echo

# Create a closure that close on outside variables
$a := 4
$b := 7.5
$fff := {|$c:$integer=1 $d| echo ($a * $b * $c); for i=$(seq 0 3) $d }
# Serialize the closure
val $fff | pup:to ./.test_file
# Unset the variables used by the closure
var:unset a b fff
# Deserialize the closure and check that the variables still exists.
$(pup:from ./.test_file) c=3 {echo 1}

# Round-trip a bare list value through pup. This was previously untested despite the
# type system claiming (see docs) that every crush value, list and dict included, can be
# losslessly serialized -- the list/dict pup serializers had zero test coverage.
$list := $(list:of 1 2 3)
val $list | pup:to ./.test_file
$restored_list := $(pup:from ./.test_file)
assert ($restored_list == $list) "a list should round-trip through pup unchanged"

# Round-trip a bare dict value through pup, same rationale as the list above.
$dict := $(dict:of a=1 b=2)
val $dict | pup:to ./.test_file
$restored_dict := $(pup:from ./.test_file)
assert ($restored_dict == $dict) "a dict should round-trip through pup unchanged"

echo "pup round trip ok"
