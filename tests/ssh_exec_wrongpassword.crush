# A wrong password must be a hard authentication error, isolated from host-key
# rejection by using a known_hosts file that *does* match the server's fixed, committed
# host key (see ssh-service/src/main.rs).

$host_file := $(convert $file "./.ssh_known_hosts_wrongpassword")
bin:from "127.0.0.1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPABgyOJckbS7f/mCs1K+zm7WApZ5fxPvES1xyrKWqef\n" | bin:to $host_file

$msg := ""
try {
    remote:exec {(1 + 1)} "127.0.0.1:2849" username="crushtest" password="not-the-right-password" host_file=$host_file
} catch {
    |$e| $msg = $e:message
}
assert ($($msg:len) > 0) "a wrong password should be a caught, non-empty error"
# `like`'s glob semantics treat `/` as a path separator that `*` won't cross, and this
# message contains one (".../username/password)") -- split it out first so the wildcard
# only ever has to span a `/`-free chunk.
assert $(like $($msg:split "/")[0] *Authentication*) ("expected an authentication error, got: {}":format($msg))

$host_file:remove
echo "ssh exec wrongpassword ok"
