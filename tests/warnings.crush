# When a command experiences a partial failure -- e.g. one group out of many failing to
# aggregate -- it can report a warning rather than just silently continuing. Warnings
# are kept in a bounded log, queryable via crush:warnings, and (only in interactive
# mode, not exercised here) also printed immediately as they happen.
#
# group's per-group aggregator failure is the motivating case this was built for: group
# "b" below always fails, since its val column is non-numeric, so sum can't aggregate
# it -- its row is dropped from group's own output (a separate, already-documented
# behavior), but the failure is no longer invisible.

$result := $(seq 0 6 | select m={($value):mod 3} | select key={if ($m == 0) {"a"} else {if ($m == 1) {"b"} else {"c"}}} val={if ($m == 1) {"bad"} else {($m)}} | group key c={sum val} | sort key | materialize)
$row_count := $($result | count)
assert ($row_count == 2) "group b's aggregator should have failed, dropping its row from the output"

$warning_count := $($(crush:warnings | materialize) | count)
assert ($warning_count == 1) "the failed aggregator should have recorded exactly one warning"

$messages := $($(crush:warnings | materialize) | select message | list:collect)
$message := $($messages[0])
$message_len := $($message:len)
assert ($message_len > 0) "the warning should have a non-empty message"

$timestamps := $($(crush:warnings | materialize) | select timestamp | list:collect)
$timestamp := $($timestamps[0])
$timestamp_type := $(typeof $timestamp)
assert ($timestamp_type == $time) "the warning should carry a real timestamp"

# Note: this variable deliberately isn't named $files -- that would shadow the global
# `files` command for the rest of the script, since a bareword command lookup and a
# $-prefixed variable lookup share the same scope namespace.
$warning_source_files := $($(crush:warnings | materialize) | select file | list:collect)
$source_file := $($warning_source_files[0])
assert ($source_file == "tests/warnings.crush") "the warning's source should point at this script"

# fs:files also reports a warning per entry it can't stat, rather than aborting -- e.g.
# a nonexistent path given directly. The command itself still succeeds (with no output
# for the unstatable entry), it just no longer fails silently.
files ./this_path_does_not_exist_1234
$warning_count2 := $($(crush:warnings | materialize) | count)
assert ($warning_count2 == 2) "a file files can't stat should add a second warning"

$last_message := $($($(crush:warnings | materialize) | select message | list:collect)[1])
$last_message_len := $($last_message:len)
assert ($last_message_len > 0) "the fs:files warning should have a non-empty message"

# data_error(...) builds a bare CrushError with no command/source of its own -- those
# only get attached by the normal script-dispatch chain, which this internal, directly
# reported error never goes through. fs:files attaches them itself
# (.with_command()/.with_source_fallback()) specifically so this isn't empty.
$last_command := $($($(crush:warnings | materialize) | select command | list:collect)[1])
assert ($last_command == "files") "the fs:files warning should record which command reported it"
$last_source_file := $($($(crush:warnings | materialize) | select file | list:collect)[1])
assert ($last_source_file == "tests/warnings.crush") "the fs:files warning's source should point at this script, not be empty"
