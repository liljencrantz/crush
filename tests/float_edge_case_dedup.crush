# Value's Hash impl (src/lang/value/mod.rs) must agree with its PartialEq impl: if
# a == b then hash(a) must equal hash(b), or hash-based structures (uniq's HashSet, and
# Dict's underlying map) can wrongly treat equal values as distinct. +0.0 and -0.0 are
# `==` per IEEE 754 (see tests/comparisons.crush), but the Hash impl used to decompose
# the float's raw bits including the sign, so the two zeros hashed differently despite
# being equal -- this file exercises every place that distinction could leak through.
# NaN and +-infinity, for contrast, do not need any special-casing here: NaN is never
# `==` to anything (including itself), so the Hash/Eq contract has nothing to require of
# it, and +-infinity's sign is a genuine, meaningful difference (inf != -inf), not a case
# of two equal values with different bit patterns.

$c1 := $(list:of 0.0 (-0.0) | uniq | count)
assert ($c1 == 1) "+0.0 and -0.0 should collapse to a single row"

$nan := (0.0 / 0.0)
$c2 := $(list:of $nan $nan $nan | uniq | count)
assert ($c2 == 3) "distinct NaN values should never collapse, even identical ones"

$c3 := $(list:of $(float:infinity) $(float:infinity) (0.0 - $(float:infinity)) | uniq | count)
assert ($c3 == 2) "+infinity should collapse with itself, -infinity should stay distinct"

# a row whose column value is -0.0 is dropped as a duplicate of a prior 0.0
$t := $($(csv:from "first,0.0\nsecond,-0.0\nthird,1.0\n" id=$string val=$float) | uniq field=val | materialize)
$expected_t := $($(csv:from "first,0.0\nthird,1.0\n" id=$string val=$float) | materialize)
assert ($t == $expected_t)

# dict: 0.0 and -0.0 are the same key
$dict_type := $(dict $float $string)
$d := $($dict_type:new)
$d[0.0] = "first"
$d[(-0.0)] = "second"
$dlen := $($d:len)
assert ($dlen == 1) "0.0 and -0.0 should be the same dict key"
$dval := $($d[0.0])
assert ($dval == "second")
