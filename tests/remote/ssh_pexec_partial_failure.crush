# remote:pexec used to unwind an entire worker thread out of its shared host queue the
# moment one host failed to connect -- silently dropping not just that host's own row,
# but every other, perfectly reachable host that thread's worker would otherwise have
# gone on to attempt. Fixed to report a per-host failure as a warning and keep going.
# This exercises the fix against the real local ssh-service test server (see
# tests/system.rs's test_remote_ssh): one unreachable host mixed in with reachable ones,
# with parallel=1 so a single worker thread must survive the failure and keep draining
# the queue by itself.

$host_file := $(crush:env["CRUSH_TEST_SSH_HOSTS"])
$addr := "127.0.0.1:2849"
$bad_addr := "127.0.0.1:1"
$user := "crushtest"
$pass := "crushtest-password"

$rows := $(remote:pexec {(1 + 1)} $bad_addr $addr $addr username=$user password=$pass host_file=$host_file parallel=1 | materialize)
$row_count := $($rows | count)
assert ($row_count == 2) "the two reachable hosts should both still be attempted and succeed, even though the first host in the list failed"

$warnings := $(crush:warnings | materialize)
$warning_count := $($warnings | count)
assert ($warning_count == 1) "the unreachable host's failure should be reported as exactly one warning"

$messages := $($warnings | select message | list:collect)
assert ($($($messages[0]):starts_with "Failed to run command on host 127.0.0.1:1.")) "the warning should name the host that failed"
