# A wrong password must be a hard authentication error. See tests/system.rs's
# test_remote_ssh, which points CRUSH_TEST_SSH_HOSTS at a known_hosts file that *does*
# match the server (so this specifically isolates auth failure, not a host-key
# rejection) and checks stderr names an authentication failure.
remote:exec {(1 + 1)} "127.0.0.1:2849" username="crushtest" password="not-the-right-password" host_file=$(crush:env["CRUSH_TEST_SSH_HOSTS"])
