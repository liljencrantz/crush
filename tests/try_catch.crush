# try { body } catch { |$error| handler }, modeled on if's true_clause/else/false_clause
# structure (control/if.rs): `catch` is a literal keyword (like `else`), matched the same
# way if matches "else", and the catch clause is optional -- omitting it means an error
# in body propagates normally, exactly as if `try` weren't there.

echo "body succeeds: catch is not invoked, output flows through normally"
try {
    echo "body ran"
} catch {
    |$error| echo "should not run"
}

echo "body succeeds: a variable assignment inside body takes effect normally"
$result := "before"
try {
    $result = "success"
} catch {
    |$error| echo "should not run"
}
echo $result

echo "body fails: catch is invoked with a struct describing the error as its unnamed argument"
try {
    echo "reached inside body"
    convert $integer "notanumber"
    echo "should not run: body stops at the failing statement"
} catch {
    |$error| echo "caught message:" $error:message
    echo "caught type:" $error:type
    # command is a plain string when known -- not asserting a specific value here since
    # exactly what ends up attached to a given error is an implementation detail, but the
    # field should always be present and typed, never missing or erroring to access.
    assert ($(typeof $error:command) == $string) "error:command should always be a string"
}
