# crush:* commands mostly report on and control the running crush process itself.
# Several are legitimately hard to test in a golden-output script: crush:exit would end
# this very test process, and crush:terminate is a separate, already-known-buggy case
# tracked elsewhere -- both are deliberately not exercised here. Everything else gets at
# least a structural check.

## pid/ppid/arguments

assert ($(typeof $(crush:pid)) == $integer) "crush:pid should be an integer"
assert ($(crush:pid) > 0) "crush:pid should be positive"
assert ($(typeof $(crush:ppid)) == $integer) "crush:ppid should be an integer"
assert ($(crush:ppid) > 0) "crush:ppid should be positive"

# crush:arguments is [binary_path, script_path, ...] -- the binary's own path varies by
# build location, so only the shape (a non-empty list of strings) is checked.
$args := $(crush:arguments)
assert ($(typeof $args) == $(list $string)) "crush:arguments should be a list of strings"
assert ($($args:len) > 0) "crush:arguments should be non-empty when running a script"

## jobs/threads/history

# All three are just table streams reporting live process state -- checked for shape
# and a sane row count, not exact contents, since both vary run to run.
assert ($(crush:jobs | count) >= 0) "crush:jobs should not error"
$job_columns := $(crush:jobs | members | select name | list:collect name)
for col=$(list:of id parent description type status) {
    $found := $($job_columns | any_match {($value == $col)})
    assert $found $("crush:jobs should have a column called {}":format $col)
}

assert ($(crush:threads | count) >= 0) "crush:threads should not error"
$thread_columns := $(crush:threads | members | select name | list:collect name)
for col=$(list:of job_id command_id created name) {
    $found := $($thread_columns | any_match {($value == $col)})
    assert $found $("crush:threads should have a column called {}":format $col)
}

# crush:history is empty in a fresh non-interactive run like this one -- there's no
# interactive prompt to have populated it.
assert ($(crush:history | count) == 0) "crush:history should be empty in a fresh test run"

## warn

# crush:warn reports directly into the same bounded log crush:warnings reads --
# checked by count (relative to before/after, since other tests earlier in this file
# may have left warnings of their own) and by finding the message among the most
# recent entries.
$warnings_before := $(crush:warnings | count)
crush:warn "test warning message from tests/crush_namespace.crush"
assert ($(crush:warnings | count) == ($warnings_before + 1)) "crush:warn should add exactly one entry to crush:warnings"
$latest_messages := $(crush:warnings | select message | list:collect message)
$found_warning := $($latest_messages | any_match {($value == "test warning message from tests/crush_namespace.crush")})
assert $found_warning "crush:warn's message should appear in crush:warnings"

## run_mode/language_mode

# Both are genuinely deterministic here: a script run non-interactively is always
# "non-interactive", and the top level of a .crush file is always Command mode.
assert ($(crush:run_mode) == "non-interactive") "crush:run_mode should be non-interactive when running a script"
assert ($(crush:language_mode) == "command") "crush:language_mode should be command at the top level of a script"

## highlight

# crush:highlight is a dict of syntax-highlight category -> ANSI color code. The exact
# color values are configuration, not something to pin down, but the set of documented
# category keys should always be present.
$highlight_keys := $(crush:highlight | select key | list:collect key)
for key=$(list:of operator string_literal file_literal identifier numeric_literal glob_literal regex_literal command keyword error warning comment) {
    $found := $($highlight_keys | any_match {($value == $key)})
    assert $found $("crush:highlight should have a key called {}":format $key)
}

## byte_unit / locale -- both are get/set/list config scopes

$byte_units := $(crush:byte_unit:list | select name | list:collect name)
assert ($($byte_units:len) == 3) "crush:byte_unit:list should offer exactly binary/decimal/raw"
for unit=$(list:of binary decimal raw) {
    $found := $($byte_units | any_match {($value == $unit)})
    assert $found $("crush:byte_unit:list should include {}":format $unit)
}
$original_byte_unit := $(crush:byte_unit:get)
crush:byte_unit:set decimal
assert ($(crush:byte_unit:get) == "decimal") "crush:byte_unit:set should change what :get reports"
crush:byte_unit:set $original_byte_unit

# crush:locale:list is a real system-dependent list of every locale the host has
# installed -- checked only for a sane non-zero count, not specific entries, since
# which locales exist varies by machine.
assert ($(crush:locale:list | count) > 0) "crush:locale:list should report at least one installed locale"
$original_locale := $(crush:locale:get)
assert (($($original_locale:len)) > 0) "crush:locale:get should return a non-empty string"
crush:locale:set $original_locale
assert ($(crush:locale:get) == $original_locale) "crush:locale:set should round-trip back to the same locale"

## warning_limit / prompt / title -- simple get/set config scopes

$original_warning_limit := $(crush:warning_limit:get)
crush:warning_limit:set 50
assert ($(crush:warning_limit:get) == 50) "crush:warning_limit:set should change what :get reports"
crush:warning_limit:set $original_warning_limit

crush:prompt:set {echo "test> "}
assert ($(typeof $(crush:prompt:get)) == $command) "crush:prompt:get should return the command set via :set"

crush:title:set {echo "test title"}
assert ($(typeof $(crush:title:get)) == $command) "crush:title:get should return the command set via :set"

## env -- crush:env is a dict-like scope, addressed by subscript, not get/set/unset
## methods (only :list and :unset exist as commands; reads/writes go through [...])

$(crush[env])["MY_TEST_VAR_XYZ"] = "hello"
assert ($($(crush[env])["MY_TEST_VAR_XYZ"]) == "hello") "crush:env should round-trip a value set via subscript"
$(crush[env]):unset MY_TEST_VAR_XYZ
$env_errored := $false
try {
    $(crush[env])["MY_TEST_VAR_XYZ"]
} catch {|$e|
    $env_errored = $true
}
assert $env_errored "crush:env should no longer have a variable after :unset"

## pause/resume

# A job id that could never exist should error cleanly rather than doing nothing.
$pause_errored := $false
try {
    crush:pause 999999999
} catch {|$e|
    $pause_errored = $true
}
assert $pause_errored "crush:pause with a nonexistent job id should error"

$resume_errored := $false
try {
    crush:resume 999999999
} catch {|$e|
    $resume_errored = $true
}
assert $resume_errored "crush:resume with a nonexistent job id should error"
