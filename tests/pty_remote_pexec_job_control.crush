# Regression test: `remote:pexec` already cooperates with job control correctly --
# each worker thread registers its own controller via `run_remote` (see
# src/builtins/remote.rs) -- confirmed during this plan's audit of every
# stream-source command. Not expected to find a bug; here so a future regression
# gets caught. Uses the in-process test sshd fixture (same pattern as
# tests/ssh_pexec_partial_failure.crush), never a real network host.
source tests/pty_test_helpers.crush
$host_file := $(convert $file $(".ssh_known_hosts_pexec_job_control_{}":format $(random:integer 1000000000)))
bin:from "127.0.0.1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPABgyOJckbS7f/mCs1K+zm7WApZ5fxPvES1xyrKWqef\n" | bin:to $host_file

$t := $(pty_spawn)
$n := $(pty_enable_counted_prompt $t)

$n = $(pty_run $t $n $("$host_file := {}":format $host_file))
$n = $(pty_run $t $n $("$addr := \"127.0.0.1:{}\"":format ($(crush:env["SSHD_PORT"]))))
$n = $(pty_run $t $n "$user := \"crushtest\"")
$n = $(pty_run $t $n "$pass := \"crushtest-password\"")

$n = $(pty_run $t $n "remote:pexec {sleep 100s} $addr $addr username=$user password=$pass host_file=$host_file parallel=2 | count &")
pty_assert_job_status $t 0 "Running"

$n = $(pty_run $t $n "terminate 0")
pty_assert_job_status $t 0 "Terminated"

$t:close
$host_file:remove
echo "ok"
