# sort used to give NaN a defined position (always sorting last), silently accepting it as
# ordinary input. That was changed: NaN has no meaningful position relative to other floats,
# so sort now fails with an error instead of picking an arbitrary place for it.
$msg := ""
try {
    list:of 3.0 $(float:nan) 1.0 | sort | echo
} catch { |$e| $msg = $e }
echo "barrier"
echo $msg

# -infinity and +infinity are ordinary, well-ordered values (not NaN), so they still sort at
# the extremes as expected. +0.0 and -0.0 compare as equal (per param_partial_cmp, which just
# delegates to f64's own partial_cmp), so sort (a stable sort) leaves them in their original
# relative order rather than erroring or crashing.
list:of 3.0 1.0 (0.0 - $(float:infinity)) $(float:infinity) 0.0 (-0.0) | sort | echo
