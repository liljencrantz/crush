# The other side of `pty_terminate_and_signal_external_job.crush`: once `fg` has brought a
# backgrounded external job back into the foreground, it *is* the foreground job again,
# so its process dying from a signal is an ordinary foreground death (like Ctrl-C) and
# must not leave a one-time "Terminated" row behind in `jobs` (see `cmd.rs`'s `Signaled`
# arm). Guards against "not holding the foreground" being sticky: `fg` must reset it
# (see `JobData::backgrounded`).
#
# The nested session's prompt is blocked by `fg`, so the signal is sent from this outer
# script, looking up the `sleep` by its parent pid (the nested session's own, `$t:pid`).
$crush_bin := $(crush:env["CRUSH_BIN"])
$t := $(pty:create $crush_bin)
$t:wait_for "# "
sleep $(duration:of milliseconds=300)

$t:write "cmd sleep 7434 &\n"
$t:wait_for "# "
sleep $(duration:of milliseconds=300)
$t:write "fg 0\n"
sleep $(duration:of milliseconds=800)
$vt_pid := $($t:pid)
$pid := ($(host:procs | where {(($name =~ ^(.*sleep)) and ($ppid == $vt_pid))} | select pid | sort pid reverse=$true))[0]:pid
host:signal $pid signal=SIGKILL
$t:wait_for "# "
sleep $(duration:of milliseconds=500)
$t:write "$n := $(jobs | where {($status == \"Terminated\")} | count)\n"
$t:wait_for "# "
sleep $(duration:of milliseconds=500)
$t:write "echo $(\"FG_SIG_CHECK_{}\":format $n)\n"
$t:wait_for "FG_SIG_CHECK_0"

$t:close
echo "ok"
