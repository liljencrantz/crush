# `for` in expression mode desugars (see Node::for_expr in src/lang/ast/node.rs) into a
# call to global:control:for with a named argument binding the loop variable -- the
# expression-mode equivalent of command mode's `for i=$(seq 1 5) {...}`. But the
# desugaring builds that named argument's target as a Node::Identifier (the `$i` form),
# while argument compilation only accepts a bare Node::String as a named argument's
# name -- so a `for` loop written in expression mode currently fails to even compile,
# regardless of whether the loop variable is spelled `$i` or `i` in the source.

$total := ({
    $sum := 0
    for $i = $(seq 1 5) {
        $sum = ($sum + $i)
    }
    $sum
}())
assert ($total == 15) "for loops should work inside expression mode"
