# stream/aggregation.rs's sum_any/avg_any track which of {Integer, Float, Duration} were
# actually seen in an $any-typed column and error out if more than one showed up, rather
# than silently producing a wrong answer by only summing the first type encountered or
# similar. min/max/median/prod don't have an $any dispatch arm at all, so they reject
# $any-typed columns unconditionally, whether or not the actual content happens to be
# homogeneous.
#
# Every case below is expected to error and print nothing on its own line -- a
# wrong/silent numeric answer here instead of an error would be exactly the "silent data
# loss" failure mode this test exists to catch. Each is wrapped in try/catch with an
# empty catch clause: any command's failure now halts the whole script (see
# tests/pipeline_step_error_halts.crush and tests/try_no_catch_propagates.crush), so
# without try/catch only the first case here would ever run. The final "done" line
# confirms the script ran to completion rather than aborting partway through.
$mixed_int_float := $(list:of 1 2.5)
$mixed_int_duration := $(list:of 1 $(duration:of seconds=1))
$mixed_float_duration := $(list:of 1.5 $(duration:of seconds=1))
$non_numeric := $(list:of 1 "hello")

echo "sum (int+float):"
try { $mixed_int_float | sum } catch {}
echo "avg (int+float):"
try { $mixed_int_float | avg } catch {}
echo "min (int+float):"
try { $mixed_int_float | min } catch {}
echo "max (int+float):"
try { $mixed_int_float | max } catch {}
echo "median (int+float):"
try { $mixed_int_float | median } catch {}
echo "prod (int+float):"
try { $mixed_int_float | prod } catch {}
echo "sum (int+duration):"
try { $mixed_int_duration | sum } catch {}
echo "sum (float+duration):"
try { $mixed_float_duration | sum } catch {}
echo "sum (non-numeric):"
try { $non_numeric | sum } catch {}
echo "done"
