# stream/aggregation.rs's sum_any/avg_any track which of {Integer, Float, Duration} were
# actually seen in an $any-typed column and error out if more than one showed up, rather
# than silently producing a wrong answer by only summing the first type encountered or
# similar. min/max/median/prod don't have an $any dispatch arm at all, so they reject
# $any-typed columns unconditionally, whether or not the actual content happens to be
# homogeneous.
$mixed_int_float := $(list:of 1 2.5)
$mixed_int_duration := $(list:of 1 $(duration:of seconds=1))
$mixed_float_duration := $(list:of 1.5 $(duration:of seconds=1))
$non_numeric := $(list:of 1 "hello")

$sum_errored := $false
try { $mixed_int_float | sum } catch { |$e| $sum_errored = $true }
assert $sum_errored "sum of mixed int+float should error"

$avg_errored := $false
try { $mixed_int_float | avg } catch { |$e| $avg_errored = $true }
assert $avg_errored "avg of mixed int+float should error"

$min_errored := $false
try { $mixed_int_float | min } catch { |$e| $min_errored = $true }
assert $min_errored "min of mixed int+float should error"

$max_errored := $false
try { $mixed_int_float | max } catch { |$e| $max_errored = $true }
assert $max_errored "max of mixed int+float should error"

$median_errored := $false
try { $mixed_int_float | median } catch { |$e| $median_errored = $true }
assert $median_errored "median of mixed int+float should error"

$prod_errored := $false
try { $mixed_int_float | prod } catch { |$e| $prod_errored = $true }
assert $prod_errored "prod of mixed int+float should error"

$sum_id_errored := $false
try { $mixed_int_duration | sum } catch { |$e| $sum_id_errored = $true }
assert $sum_id_errored "sum of mixed int+duration should error"

$sum_fd_errored := $false
try { $mixed_float_duration | sum } catch { |$e| $sum_fd_errored = $true }
assert $sum_fd_errored "sum of mixed float+duration should error"

$sum_nn_errored := $false
try { $non_numeric | sum } catch { |$e| $sum_nn_errored = $true }
assert $sum_nn_errored "sum of a non-numeric value should error"
