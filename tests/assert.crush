# assert checks a condition and errors (halting the script, unless caught by try/catch --
# see tests/try_catch.crush) if it's false.

echo "a true condition passes silently"
assert (1 + 1 == 2)
echo "reached"

echo "a false condition errors with a default message"
try {
    assert (1 + 1 == 3)
    echo "should not run"
} catch {
    |$error| echo "caught:" $error.message
}

echo "a custom message can be given"
try {
    assert (1 > 2) "custom message here"
} catch {
    |$error| echo "caught:" $error.message
}

echo "a catch clause can filter specifically on AssertionError, since that's a failed"
echo "assertion's error type"
try {
    assert (1 > 2) "custom message here"
} catch AssertionError {
    |$error| echo "caught by type filter:" $error.message
}

echo "a catch clause filtered on a different type does not catch an AssertionError -- it"
echo "falls through to the next clause"
try {
    assert (1 > 2)
} catch InvalidArgument {
    |$error| echo "should not run"
} catch {
    |$error| echo "fell through to the catch-all clause"
}
