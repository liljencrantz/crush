# Every builtin command declares its own help text via #[signature(...)]'s short/long/
# example fields, and `help` renders it through crate::util::md::render for terminal
# display. This test crawls the entire builtin namespace (the same approach
# generate_docs.crush uses) and calls `help` on every single command it finds, purely
# to prove that rendering completes without crashing and produces some output for all of
# them -- a help string containing unusual markdown (backticks, long lines, code blocks)
# is exactly the kind of thing that can trip up a renderer that a hand-picked handful of
# manual checks would never happen to exercise.
#
# No .crush.output file: the set of builtins differs between platforms (e.g. dbus and
# systemd only exist on Linux), so the exact rendered text is not compared. The asserts
# below are what make this test fail.

$scope_path := {
    |$s|
    if ($s == $global) {
        $s:__name__
    } else {
        "{}:{}":format $(scope_path $($s:__super__)) $($s:__name__)
    }
}

$checked := $($(list $string):new)
$failed := $($(list $string):new)
$seen := $($(dict $string $bool):new)

# Renders help for a value both to the terminal and as markdown, recording a failure if
# either one errors out or the markdown comes back empty.
$check_help := {
    |$val $label|
    try {
        help $val
        $md := $(help $val format="markdown")
        if ($($md:len) > 0) {
            $checked:push $label
        } else {
            $failed:push $("{} (empty help)":format $label)
        }
    } catch {|$e|
        $failed:push $("{} (help rendering failed)":format $label)
    }
}

# Member lookup is wrapped in try/catch, same as generate_docs.crush: a few builtins
# (e.g. crush:env:list, users:list) touch real OS/environment state and can fail to even
# look up in this context -- that is not a help rendering problem, so it is not counted
# as a failure.
$crawl := {
    |$s|
    $path := $(scope_path $s)
    if ($seen:contains($path)) {
        return
    }
    $seen[$path] = $true

    for name=$(dir $s) {
        if ($name:starts_with("__")) {
        } else {
            # Holds the looked-up member, if the lookup succeeded. A list is used because
            # a variable can't be reassigned to a value of a different type.
            $found := $($(list $any):new)
            try {
                $found:push $($s[$name])
            } catch {|$e|
            }
            if ($($found:len) > 0) {
                $val := $($found[0])
                $t := $(typeof $val)
                if ($t == $scope) {
                    crawl $val
                } else {
                    if ($t == $command) {
                        check_help $val $("{}:{}":format $path $name)
                    }
                }
            }
        }
    }
}

crawl $global
$_barrier := "x"

# `help` on a command exercises the Help impl for commands; it never touches
# ValueType::short_help/long_help/Display::fmt, which are a completely separate set of
# match arms (one per type, in src/lang/value/value_type.rs) that the crawl above can't
# reach -- types aren't listed by `dir` the way commands are, since they're merged into
# the root scope via `use` rather than declared as members of it. So this is a flat,
# hardcoded list rather than a crawl: one value per `ValueType` variant, covering every
# variant declared in value_type.rs (a new variant not added here is still exercised by
# value_type_variants_are_all_accounted_for_in_serialization_crush in
# src/lang/value/mod.rs, but that test doesn't call `help` -- add it here too).
$command_count := $($checked:len)
$all_types := $(list:of \
    $string $integer $time $duration $glob $re $command $file \
    $table_input_stream $table_output_stream $table $struct \
    $(list $string) $(dict $string $integer) $scope $bool $float \
    $empty $any $binary_stream $binary $type $(one_of $string $integer) \
)
for t=$all_types {
    check_help $t $("{}":format $t)
}
$_barrier2 := "x"

for f=$failed {
    echo $f
}
assert ($($failed:len) == 0)
assert ($command_count > 0)
assert ($($checked:len) == $command_count + $($all_types:len))
