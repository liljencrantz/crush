# Smoke test: `remote:host:list` is a bounded, one-shot source (lists known_hosts
# entries, returns well under a second) -- nothing to interrupt mid-flight (see this
# plan's Review Focus). Confirms it still completes (or fails cleanly, e.g. with no
# known_hosts file present) when run through a real interactive pty session, and
# that backgrounding, Ctrl-Z/bg/fg around it, and the session itself afterward all
# keep working.
source tests/pty_test_helpers.crush
$t := $(pty_spawn)

$t:run "try { remote:host:list } catch {|$e| } &"
$t:write $t:control:z
$t:wait_for "# "
$t:run "bg"
$t:run "fg"
$t:write "echo still_alive_marker\n"
$t:wait_for "still_alive_marker"

$t:close
echo "ok"
