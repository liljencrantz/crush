# Regression test: JobData.parent used to be a plain, recyclable integer with nothing
# clearing it once the job it referred to actually died -- so once that id was handed
# out again to a completely unrelated job, the OLD job's stale `parent` value would
# accidentally match the NEW job's id. descendant_job_ids() (which pause()/resume()/
# terminate() use to also affect every "descendant" of the job they're given) would
# then incorrectly treat the old, unrelated job as a child of the new one, e.g.
# pausing the new job would also silently pause the old, completely unrelated one.
#
# `$job_id := $(cmd sleep 30 &)` desugars into a nested pair of jobs: the whole
# "$job_id := $(...)" assignment statement's own job (call it X), and, nested inside
# its evaluation of the $(...) substitution, the actual "cmd sleep 30 &" job that
# job_id's value refers to. X only needs to wait for the substitution's (fast) return
# value, not the backgrounded job's actual (slow) completion, so X finishes and is
# reaped almost immediately -- freeing its id for reuse while job_id's own job is
# still very much alive, with `parent` still pointing at X's now-dead id.
#
# The fix: dying jobs orphan their children (clear `parent` to Empty) instead of
# leaving a dangling id behind for something else to collide with later. This keeps
# small, consecutive, predictable job ids (deliberately *not* changed here, per a
# classic shell feature people rely on) without the danger of a recycled id being
# misread as an old, unrelated parent-child relationship.

$job_id := $(cmd sleep 30 &)
sleep $(duration:of milliseconds=300)

# A job's `parent` is only ever meaningful while that parent is still alive -- once
# it's died, orphaning should have already cleared it to Empty, rather than leaving
# behind X's old numeric id for something else to later collide with.
#
# The `parent` column's declared type is `one_of(integer, empty)`, and `$empty` is
# itself a *type* value (usable in signature declarations), not an instance of an
# empty value -- so `== $empty` can never match an actual empty value. Instead,
# probe whether the value behaves like an integer (arithmetic succeeds) or not
# (arithmetic errors, caught below) to tell the two apart.
$rows := $(crush:jobs | where {($id == $job_id)} | materialize)
$parent_after_x_died := $($rows[0]):parent
$parent_is_still_an_id := $true
try {
    $unused := ($parent_after_x_died + 0)
} catch {|$e|
    $parent_is_still_an_id = $false
}
assert (!$parent_is_still_an_id) "job_id's dead parent should have been orphaned (cleared to empty) once it was reaped, not left as a stale id"

# The very next job created (a bare, uncaptured `... &`, so there's no wrapping
# "$x := $(...)" assignment job of its own) is deterministically handed the smallest
# currently-unused id -- which, before the fix, would have been X's just-freed one.
# This job is unrelated to $job_id in every way.
cmd sleep 31 &
sleep $(duration:of milliseconds=300)
$colliding_id := $($($(crush:jobs | where {like $definition *sleep*31*} | materialize)[0]):id)

# Pausing the unrelated job must never affect $job_id, regardless of whether their ids
# happen to collide with whatever job_id's parent used to be.
crush:pause $colliding_id
sleep $(duration:of milliseconds=200)
$job_id_status := $($($(crush:jobs | where {($id == $job_id)} | materialize)[0]):status)
assert ($job_id_status == "Running") "pausing an unrelated job must not pause job_id itself, no matter what id it was handed"

crush:terminate $job_id
crush:terminate $colliding_id
echo "done"
