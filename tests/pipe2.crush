# A test to make sure that we can correctly share the output
# of a command between multiple commands via the same pipe.
crush:locale:set "en_US.UTF-8"

# Create the pipe
$pipe := $($(table_input_stream value=$integer):pipe)

# Attach the input end to a bunch of seq commands
$input1 := $(seq 0 10_000 | pipe:write &)

# Attach the output end to the sum command and
$sum_job_id1 := $(pipe:read | sum &)
$sum_job_id2 := $(pipe:read | sum &)
$sum_job_id3 := $(pipe:read | sum &)
$sum_job_id4 := $(pipe:read | sum &)

# Wait for the writer job to fully finish writing before closing the pipe: pipe:write
# reads $pipe's own fields on its own worker thread whenever it happens to get
# scheduled, with no synchronization against pipe:close clearing those same fields --
# fg-ing the writer first guarantees it has already finished using them. See
# tests/pipe3.crush for the same pattern with multiple writers.
fg $input1

# Close the output and input, so that the input can actually
# reach EOF once the above 4 invocation exit
pipe:close
# Wait for the sum command to finish
assert (($(fg $sum_job_id1) + $(fg $sum_job_id2) + $(fg $sum_job_id3) + $(fg $sum_job_id4)) == 49_995_000)
