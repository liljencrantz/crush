# try without a catch clause is supposed to be a no-op wrapper: an error in body
# propagates exactly as if try weren't there, which (per pipeline_step_error_halts.crush)
# now means halting the script. This isn't really about try specifically -- any command
# invoked from inside a closure body has the same problem, since try's body is itself
# just a closure.
#
# Expected output is empty: neither "reached" line should ever print.
try {
    convert $integer "notanumber"
}
echo "reached (bare try, no catch)"

{convert $integer "notanumber"}
echo "reached (plain closure, no try at all)"
