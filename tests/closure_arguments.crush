# Closure argument binding (push_arguments_to_env in src/lang/command/closure.rs) has a
# lot of branches that ordinary closure calls never touch: named (@@) and unnamed (@)
# collectors, default-value fallback, and the various wrong-argument-count error paths.
# This file exercises those directly, plus round-tripping a closure with all of the
# above through pup serialization, plus the closure's own text `definition` through a
# real re-parse (which caught a real bug -- see the fix note below).

## Named and unnamed collectors, regular call syntax

$collect := {|$a $b @ $rest @@ $extra|
    struct:of a=$a b=$b rest=$rest extra=$extra
}
$r1 := $($collect 1 2 3 4 5 x=10 y=20)
assert ($r1:a == 1) "positional params before the collectors should still bind normally"
assert ($r1:b == 2) "positional params before the collectors should still bind normally"
assert ($r1:rest == $(list:of 3 4 5)) "the unnamed collector should gather every leftover unnamed argument, in order"
assert ($r1:extra == $(dict:of x=10 y=20)) "the named collector should gather every unmatched named argument"

# A closure with only an unnamed collector doesn't declare a named one, so it must
# error on any named argument instead of silently discarding it.
$unnamed_only := {|@ $rest| $rest}
$stray_named := ""
try {
    $unnamed_only 1 2 x=3
} catch {
    |$e| $stray_named = $e:message
}
assert ($stray_named == "`unnamed_only`: Unknown named argument `x`.") \
    "a closure with no named collector should reject any named argument"

## @ / @@ spreading a list/dict back into a call should be equivalent to passing the
## same arguments directly

$args_list := $(list:of 3 4 5)
$kwargs_dict := $(dict:of x=10 y=20)
$r2 := $($collect 1 2 @ $args_list @@ $kwargs_dict)
assert ($r1 == $r2) "spreading a list/dict at the call site should produce the same result as passing the arguments directly"

## Default value fallback

$def := {|$a $b: $integer = 42| ($a + $b)}
assert ($($def 1) == 43) "an omitted parameter with a default should fall back to it"
assert ($($def 1 b=5) == 6) "naming a defaulted parameter should override the default"

# A parameter with a default is only ever filled by naming it -- a second *positional*
# argument never reaches it, even if one is given. Since there's no unnamed collector,
# that leftover positional argument is then a genuine stray and must error.
$stray_after_default := ""
try {
    $def 1 99
} catch {
    |$e| $stray_after_default = $e:message
}
assert ($stray_after_default == "`def`: Stray unnamed argument.") \
    "a positional argument must never silently fill a defaulted parameter"

## Wrong argument counts

$f := {|$a $b| ($a + $b)}

$missing := ""
try { $f 1 } catch { |$e| $missing = $e:message }
assert ($missing == "`f`: No argument supplied for parameter `b`.") \
    "calling with too few arguments and no default should name the missing parameter"

$stray := ""
try { $f 1 2 3 } catch { |$e| $stray = $e:message }
assert ($stray == "`f`: Stray unnamed argument.") \
    "calling with too many positional arguments and no unnamed collector should error"

$unknown_named := ""
try { $f 1 2 z=9 } catch { |$e| $unknown_named = $e:message }
assert ($unknown_named == "`f`: Unknown named argument `z`.") \
    "an unrecognized named argument with no named collector should error"

## A named parameter whose declared type is `list` accumulates across repeated uses of
## the same name, instead of the later value overwriting the earlier one -- and passing
## a list value appends its elements rather than nesting it as a single element.

$lf := {|$xs: $(list $integer)| $xs}
assert ($($lf xs=1 xs=2 xs=3) == $(list:of 1 2 3)) \
    "repeating a list-typed named argument should accumulate values, not overwrite them"
assert ($($lf xs=$(list:of 5 6) xs=7) == $(list:of 5 6 7)) \
    "passing a list value to a list-typed named argument should append its elements, not nest the list itself"

## Serializing a closure that uses collectors and a default should preserve all of that
## behavior across the pup round trip -- Command values have no meaningful `==`, so
## compare behavior instead of identity, same as the plain-closure check in
## tests/serialization.crush.

val $collect | pup:to ./.closure_test_file
$restored_collect := $(pup:from ./.closure_test_file)
$restored_r1 := $($restored_collect 1 2 3 4 5 x=10 y=20)
assert ($restored_r1 == $r1) "a closure with named/unnamed collectors should behave identically after a pup round trip"

val $def | pup:to ./.closure_test_file
$restored_def := $(pup:from ./.closure_test_file)
assert ($($restored_def 1) == 43) "a closure's default value should still apply after a pup round trip"
rm ./.closure_test_file

## A closure's own text `definition` (src/builtins/types/mod.rs's `definition` command)
## must round-trip through a real parse, not just look right. Rather than pinning the
## rendered text itself -- which is free to change -- feed it back through `source` and
## check the *restored* closure behaves the same as the original for the same call.
## This caught a real bug: `Display for Parameter`'s `@@`/`@` collector arms
## (src/lang/command/mod.rs) rendered a collector as `@rest`/`@@extra`, dropping the `$`
## sigil the parser requires, so a closure using them could never be re-parsed from its
## own definition. Fixed to render `@ $rest`/`@@ $extra`.

$complex := {|$a $b: $integer = 7 @ $rest @@ $extra|
    struct:of a=$a b=$b rest=$rest extra=$extra sum=($a + $b)
}
$def_text := $(definition $complex)
$src := $("$restored_complex := {}":format $def_text)
source $src

$before := $($complex 1 2 3 4 x=10 y=20)
$after := $($restored_complex 1 2 3 4 x=10 y=20)
assert ($before == $after) "a closure re-parsed from its own `definition` text should behave the same as the original"

echo "closure argument tests ok"
