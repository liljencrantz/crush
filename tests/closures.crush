# closure.rs (src/lang/command/closure.rs) is the largest file in the crate and had no
# direct test coverage beyond tests/closure_signatures.crush's single typed-dict-param
# example. tests/return.crush separately covers recursion and returning a value.

echo "a closure captures variables from its enclosing scope"
$x := 10
$f := {|$y| echo ($x + $y)}
$f 5

echo "default parameter values"
$g := {|$a: $integer=1 $b: $integer=2| echo ($a + $b)}
$g
$g a=10
$g a=10 b=20

echo "repeating a named argument collects it into a list-typed parameter"
$h := {|$items: $(list $integer)| echo $items}
$h items=1 items=2 items=3

echo "@$rest collects leftover unnamed arguments into a list"
$i := {|$first @$rest| echo $first; echo $rest}
$i 1 2 3

echo "@@$rest collects leftover named arguments"
$j := {|$first @@$rest| echo $first; echo $rest}
$j first=1 a=2 b=3

# `return` can only be used inside a closure *command* (one with a `{|...| ...}`
# signature); a bare `{...}` block -- like an `if`/`while` body, which is what this is
# -- can't break early with it. Any command's failure now halts the whole script (see
# tests/pipeline_step_error_halts.crush and tests/try_no_catch_propagates.crush), so
# this is wrapped in try/catch to let the script reach the final "done" marker.
echo "return inside a bare block (not a closure command) errors"
try {
    if $true {
        return 5
    }
} catch {}
echo "done"
