# Pattern matching (string/regex/glob/type/...) is unified under one mechanism: any
# value can act as a pattern by implementing an `__is__` method (and, for negation,
# `__is_not__`). These are named with dunders specifically because they aren't meant to
# be called directly -- the public interface is the `like` command (which just calls
# `pattern:__is__ value`) and, in expression mode, the `=~`/`!~` operators (which desugar
# to the same methods, receiver-reversed since the method lives on the pattern).
assert $(like fooo ^(ooo))
assert (!$(like fooo ^(zzz)))
assert (fooo =~ ^(ooo))
assert (fooo !~ ^(zzz))

# A pattern can be a regex, a glob, a plain string (exact match), or a type (checks the
# value's own type) -- `like` doesn't care which, as long as it has `__is__`.
$re := ^(a+b)
assert $(like "aaab" $re)
assert (!$(like "xyz" $re))

$g := $(glob:new "*.txt")
assert $(like "foo.txt" $g)
assert (!$(like "notatextfile" $g))

assert $(like "abc" "abc")
assert (!$(like "abc" "abd"))

assert $(like 5 $integer)
assert (!$(like "hello" $integer))

# Multiple patterns: true as soon as any one of them matches.
assert $(like "foo.txt" ^(zzz) $g "nope")
assert (!$(like "foo.txt" ^(zzz) "nope"))

# The dunder methods are still real, callable methods -- just not the intended surface.
assert $($re:__is__ "aaab")
assert (!$($re:__is_not__ "aaab"))

# string/glob/regex's __is__ accept a `file` value as the thing being tested, not just a
# `string` -- the needle argument is typed `Text` (file-or-string), so this has always
# worked, it just had no test coverage before.
assert $(like foo.txt *.txt)
assert $(*.txt:__is__ foo.txt)
assert $(like foo.txt ^(.*\.txt))
assert $(^(.*\.txt):__is__ foo.txt)
assert $(like foo.txt "foo.txt")
assert $("foo.txt":__is__ foo.txt)

# =~/!~ work with a file value too. Files must always be quoted in expression mode --
# a bare unquoted file literal is only recognized as such in command mode, by design --
# so store it in a variable first (or quote it, 'foo.txt') rather than writing it bare.
$f := foo.txt
$txt_glob := *.txt
echo "barrier"
assert ($f =~ $txt_glob)
assert (!($f !~ $txt_glob))
