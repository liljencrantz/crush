$branch := ""
if $true {
    $branch = "yes"
}
assert ($branch == "yes")

$branch2 := ""
if $false {
    $branch2 = "no"
} else {
    $branch2 = "fallback"
}
assert ($branch2 == "fallback")

$branch3 := "unchanged"
if $false {
    $branch3 = "no"
}
assert ($branch3 == "unchanged") "the body of a false if with no else should not run"
