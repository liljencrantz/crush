# With allow_not_found set, a host missing from known_hosts is trusted on first use
# instead of erroring -- exercises the CheckResult::NotFound + allow_not_found branch in
# remote.rs's run_remote(). The connection should still succeed, and the server's real
# key should end up pinned into the known_hosts file afterwards.

$host_file := $(convert $file "./.ssh_known_hosts_allow_not_found")
bin:from "" | bin:to $host_file

$r := $(remote:exec {(1 + 1)} "127.0.0.1:2849" username="crushtest" password="crushtest-password" host_file=$host_file allow_not_found=$true)
assert ($r == 2) "remote:exec should still succeed and return its result when allow_not_found pins a new key"

$pinned := $(bin:from $host_file | materialize | convert $string)
# A plain prefix check, not `like`/glob: the key contains a literal `/`, which crush's
# glob engine treats as a path separator that `*` won't cross.
assert $($pinned:starts_with "127.0.0.1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPABgyOJckbS7f/mCs1K+zm7WApZ5fxPvES1xyrKWqef") \
    ("allow_not_found should have pinned the server's actual key into the known_hosts file, got: {}":format($pinned))

$host_file:remove
echo "ssh exec allow not found ok"
