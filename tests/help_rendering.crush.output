[32mcontrol[0m[36m:[0m[32mfg[0m [36m[[0m[36mjob[0m[36m=[0m[36minteger[0m[36m][0m
Return the output of a background pipeline

A job started with a trailing [32m&[0m runs in the background and registers its eventual 
result for later retrieval; [32mfg[0m waits for and returns that result.

This command accepts the following arguments:

 * [32mjob[0m the job id of the background job to put into the foreground.

[4mExamples[0m
[33m# Create a pipe[0m
[36m$pipe[0m [36m:=[0m [36m$([0m[36m$([0m[36mtable_input_stream[0m [36mvalue[0m[36m=[0m[36m$integer[0m[36m)[0m[36m:[0m[36mpipe[0m[36m)[0m
[33m# Create a job that writes 100_000 integers to the pipe and put this job in the background[0m
[32mseq[0m [36m100_000[0m [36m|[0m [32mpipe[0m[36m:[0m[32mwrite[0m &
[33m# Create a second job that reads from the pipe and sums all the integers and put this job in the background[0m
[36m$sum_job_handle[0m [36m:=[0m [36m$([0m[36mpipe[0m[36m:[0m[36mread[0m [36m|[0m [32msum[0m &[36m)[0m
[33m# Close the pipe so that the second job can finish[0m
[32mpipe[0m[36m:[0m[32mclose[0m
[33m# Put the sum job in the foreground[0m
[32mfg[0m [36m$sum_job_handle[0m

