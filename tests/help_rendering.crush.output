            variable.

[4mExamples[0m
[33m# Iterate over the processes on the host[0m
[32mfor[0m [36mi[0m[36m=[0m[36m$([0m[36mhost[0m[36m:[0m[36mprocs[0m[36m)[0m [36m{[0m
  [32mecho[0m [36m$([0m[36m"Iterating over process {}"[0m[36m:[0m[36mformat[0m [36m$i[0m[36m:[0m[36mname[0m[36m)[0m
[36m}[0m
[33m# Print ten messages[0m
[32mfor[0m [36mi[0m[36m=[0m[36m$([0m[36mseq[0m [36mto[0m[36m=[0m[36m10[0m[36m)[0m [36m{[0m
  [32mecho[0m [36m$([0m[36m"Lap #{}"[0m[36m:[0m[36mformat[0m [36m$i[0m[36m)[0m
[36m}[0m

