# `types.file.remove`'s recursive delete (a `file` value's `:remove recursive=$true`
# method, src/builtins/types/file.rs) does real filesystem I/O for every entry, and
# -- in the default (non-verbose, no errors) case -- never calls `output.send()` at
# all until it's completely done, the same gap `fs:usage` had (see that fix's own
# commit): confirmed directly, measuring `host:procs`' own `cpu` column showed the
# delete kept consuming CPU for a noticeable stretch after `terminate` before this
# task's fix.
#
# 100,000 files, chosen empirically: deletes in ~4s uninterrupted on a normal dev
# machine, comfortably longer than the time it takes this test to issue `terminate`
# after backgrounding it. Built with a `python3 -c` one-liner (via `cmd`) rather than
# a crush loop, since crush's own per-iteration overhead would make *setup* the slow
# part instead of the delete -- a one-liner specifically, not a multi-line script:
# `cmd` splits every argument's string value on `\n` into separate argv entries (see
# pty_fs_usage_job_control.crush's own note on this). Path is randomized (not a fixed
# name) so two worktrees/runs of this suite can never collide on the same tree.
#
# The decisive check is comparing the remaining-file count right after `terminate`
# against the same count a second later, not just CPU: a CPU-only check can pass
# trivially if the delete happens to finish inside this test's own timing budget
# regardless of whether `terminate` did anything, and a single remaining-file count
# right after `terminate` can't tell "stopped early" apart from "still mid-delete at
# the moment checked" either -- it's always well above 0 either way, this early. A
# *second* count taken a second later directly answers "did deleting actually stop":
# unchanged means it stopped; still dropping means it didn't.
source tests/pty_test_helpers.crush
$tree := $("/tmp/pty_file_remove_job_control_tree_{}":format $(random:integer 1000000000))
cmd mkdir "-p" $tree
cmd python3 "-c" $("import os; os.chdir('{}'); [open('f' + str(i), 'w').close() for i in range(100000)]":format $tree)

$t := $(pty_spawn)
$t:write $("$tree := $(convert $file {})\n":format $tree)
$t:wait_quiet
$t:run "$tree:remove recursive=$true &"
$cpu_before := $(host:procs | where {($pid == ($t:pid()))} | select cpu)[0]:cpu

$t:run "terminate 0"
$remaining_a := $(fs:files $tree | count)
assert ($remaining_a > 0) $("expected terminate to stop the delete early, but all files were already gone ({} remaining)":format $remaining_a)

sleep 1s
$remaining_b := $(fs:files $tree | count)
assert ($remaining_b == $remaining_a) $("expected no further files to be deleted in the second after terminate, went from {} to {} remaining":format $remaining_a $remaining_b)

$cpu_after := $(host:procs | where {($pid == ($t:pid()))} | select cpu)[0]:cpu
assert ($cpu_after <= ($cpu_before + 300ms)) $("expected no significant CPU growth in the second after terminate, got {} -> {}":format $cpu_before $cpu_after)

$t:close
cmd rm "-rf" $tree

# Uninterrupted case must keep working identically to before this task.
$tmp := $(convert $file $("/tmp/pty_file_remove_job_control_check_{}":format $(random:integer 1000000000)))
$tmp:mkdir
$tmp["a"]:touch
$tmp:remove recursive=$true
assert (!($tmp:exists())) "the directory should no longer exist after an uninterrupted recursive remove"
echo "ok"
