# `systemd:journal --follow`'s inner loop called `journal.await_next_entry(None)`,
# blocking indefinitely once the end of the journal was reached, with no way to
# notice `terminate`/`pause` while waiting for an entry that may never come -- the
# exact same gap `fs:usage` had (see that fix's own commit), fixed the same way:
# poll with a short timeout instead of blocking forever, and check `output`'s
# already-interruptible control channel (via `poll_control()`) between polls.
#
# This module is Linux-only (`#[cfg(target_os = "linux")]` in src/builtins/mod.rs,
# gated on the `systemd` crate itself only being a dependency on Linux) and cannot be
# built or run on this Darwin dev machine -- the Rust change is self-reviewed but
# UNVERIFIED locally; this file's own first line makes it a clean no-op skip here,
# and a real check on Linux CI. Same precedent as tests/dbus.crush.
if ($(host:os:name) != "linux") {
    exit
}

source tests/pty_test_helpers.crush
$t := $(pty_spawn)

$t:run "systemd:journal follow=$true &"
$t:run "terminate 0"
pty_assert_job_status $t 0 "Terminated"
$t:write $("echo $(\"__PTY_THREAD_COUNT__{{}}\":format ($(crush:threads | where {{($job_id == {})}} | count)))\n":format 0)
$t:wait_for "__PTY_THREAD_COUNT__0"

$t:close
echo "ok"
