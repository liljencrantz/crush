# Regression test: stream:tee gives each branch its own output stream via
# `branch_sender.initialize(&types)?` (a plain pipe(), not `context.initialize_output`),
# so unlike tee's own passthrough output, a branch's stream never gets a control
# receiver wired up (see TableOutputStream::control's and stream:group's own
# broadcast_control's doc comments for why a plain, uncontrolled TableOutputStream can't
# respond to crush:pause/crush:terminate at all). A branch that doesn't drain its input
# (here, an infinite loop that never reads it) fills that stream's bounded row buffer,
# and tee's own row-feeding loop blocks forever trying to send it more -- with no way
# for a job-control message sent to the job to ever reach that specific blocked send and
# unstick it.
#
# 10,000 rows is comfortably past the row channel's buffer, so the branch is provably
# still being fed (and tee's own loop provably still blocked on it) once the background
# dispatch above returns.

$job_id := $(seq 1 10000 | tee {while {$true} {}} | count &)
$start := $(time:now)
crush:terminate $job_id
$result := $(fg $job_id)
$end := $(time:now)
assert (($end - $start) < $(duration:of seconds=5)) "crush:terminate should stop a tee job whose branch is blocked on its own uncontrolled output stream almost immediately, not leave it stuck forever"

echo "ok"
