# Same investigation and conclusion as pty_random_integer_stream_job_control.crush --
# see that file's header comment for the full explanation (and the correction to it:
# `output` already has a registered controller via `context.initialize_output`, and
# `TableOutputStream::send` already checks it on every call -- that, not generic
# backpressure, is why this command already cooperates with no extra code).
# `random:float_stream` has the identical loop shape and the same empirical result:
# terminate/pause already stop it promptly in every real scenario tested. No failing
# test to drive a Rust change -- regression guard only.
source tests/pty_test_helpers.crush
$t := $(pty_spawn)

$t:run "random:float_stream | count &"
sleep 300ms
$cpu_running := $(host:procs | where {($pid == ($t:pid()))} | select cpu)[0]:cpu

$t:run "pause 0"
$cpu_a := $(host:procs | where {($pid == ($t:pid()))} | select cpu)[0]:cpu
sleep 500ms
$cpu_b := $(host:procs | where {($pid == ($t:pid()))} | select cpu)[0]:cpu
assert ($cpu_b <= ($cpu_a + 50ms)) $("expected no measurable CPU growth while paused, got {} -> {} (was {} while running)":format $cpu_a $cpu_b $cpu_running)

$t:run "resume 0"
$t:run "terminate 0"
pty_assert_job_status $t 0 "Terminated"
pty_assert_no_thread $t 0

$t:close

# Uninterrupted case must keep working identically to before this plan.
$rows := $(random:float_stream 100 | head 5 | count)
assert ($rows == 5) "random:float_stream must still work normally when never interrupted"

echo "ok"
