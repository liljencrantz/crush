#! /usr/bin/env crush
#
# Generates Markdown reference documentation for every builtin command by
# introspecting the running binary's own root scope. Run it with the crush
# binary you want documented, e.g.:
#
#   crush generate_docs.crush > docs/builtins.md

$scope_path := {
    |$s|
    if ($s == $global) {
        $s:__name__
    } else {
        "{}:{}":format $(scope_path $($s:__super__)) $($s:__name__)
    }
}

$names := $($(list $string):new)
$docs := $($(dict $string $string):new)
$errors := $($(list $string):new)
$seen := $($(dict $string $bool):new)

# Recursively walks every nested namespace under $s, collecting every command
# it finds (name -> markdown help text) into $names/$docs. Wrapped in
# try/catch per member: a few builtins (e.g. crush:env:list, users:list) touch
# real OS/environment state and can fail to even look up in this context --
# one bad member should not abort documenting everything else.
$crawl := {
    |$s|
    $path := $(scope_path $s)
    if ($seen:contains($path)) {
        return
    }
    $seen[$path] = $true

    for name=$(dir $s) {
        if ($name:starts_with("__")) {
        } else {
            try {
                $val := $($s[$name])
                $t := $(typeof $val)
                if ($t == $scope) {
                    crawl $val
                } else {
                    if ($t == $command) {
                        $full_name := $("{}:{}":format $path $name)
                        try {
                            $doc := $(help $val format=markdown)
                            $names:push $full_name
                            $docs[$full_name] = $doc
                        } catch {|$e|
                            $errors:push $("{} (help failed)":format $full_name)
                        }
                    }
                }
            } catch {|$e|
                $errors:push $("{}:{} (lookup failed)":format $path $name)
            }
        }
    }
}

crawl $global

$count := $($names:len)
$header := $("# Crush builtin command reference\n\nAuto-generated by generate_docs.crush by introspecting the running binary's own namespace. {} commands, {} members skipped.\n\n---\n\n":format $count $($errors:len))

# $names | sort returns a table_input_stream (not a re-usable List), so it's
# piped straight into fold here rather than stored in an intermediate
# variable and reused.
$body := $($names | sort | fold {
    $doc := $($docs[$value])
    "{}\n## {}\n\n{}\n\n---\n\n":format $acc $value $doc
} initial="")

echo --raw $("{}{}":format $header $body)
